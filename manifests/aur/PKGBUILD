# Maintainer: intelligent-username
pkgname=tmd
pkgver=0.2.0
pkgrel=1
pkgdesc="Convert files to token-efficient Markdown for LLM prompts"
arch=('x86_64' 'aarch64')
url="https://github.com/intelligent-username/tokens.md"
license=('AGPL-3.0-only')
source_x86_64=("tmd-linux-x64::https://github.com/intelligent-username/tokens.md/releases/download/v${pkgver}/tmd-linux-x64")
source_aarch64=("tmd-linux-arm64::https://github.com/intelligent-username/tokens.md/releases/download/v${pkgver}/tmd-linux-arm64")
sha256sums_x86_64=('REPLACE_WITH_SHA256_LINUX_X64')
sha256sums_aarch64=('REPLACE_WITH_SHA256_LINUX_ARM64')
noextract=("tmd-linux-x64" "tmd-linux-arm64")

package() {
  if [ "$CARCH" = "x86_64" ]; then
    install -Dm755 "${srcdir}/tmd-linux-x64" "${pkgdir}/usr/bin/tmd"
  else
    install -Dm755 "${srcdir}/tmd-linux-arm64" "${pkgdir}/usr/bin/tmd"
  fi
}
